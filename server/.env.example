# Single organizer password (US-1). Required.
ADMIN_PASSWORD=
# Signs the session cookie. Required, at least 32 random characters.
SESSION_SECRET=
# SQLite file, relative to server/ (or an absolute path). Optional: leave this line commented out
# to use data/gachafest.db. An empty value is rejected.
# DATABASE_PATH=data/gachafest.db
# Port the API listens on (127.0.0.1 only). Optional: defaults to 3000. If you change it, start the
# client with API_URL=http://127.0.0.1:<port> so the dev proxy follows.
# PORT=3000
